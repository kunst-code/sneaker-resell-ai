# SneakerAI 환경변수 설정
# 서버 배포 시 각 플랫폼의 환경변수 설정에서 입력하세요

# KicksDB (kicks.dev) - 스니커즈 가격 데이터 (필수)
KICKSDB_API_KEY=your_kicksdb_api_key

# OpenAI - Vision 이미지 인식 + AI 분석 (필수)
OPENAI_API_KEY=your_openai_api_key

# Anthropic Claude (선택)
ANTHROPIC_API_KEY=

# RapidAPI (선택 - 별도 요청 시에만 사용)
RAPIDAPI_KEY=

# 서버 포트 (기본: 8000)
PORT=8000

# Flask 디버그 모드 (배포 시 false)
FLASK_DEBUG=false
